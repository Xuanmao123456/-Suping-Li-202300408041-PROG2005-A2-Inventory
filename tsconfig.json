{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "lib": ["ES2015", "DOM"]
  },
  "include": [
    "Part1 TS/**/*",
    "Part2_Angular/**/*"
  ],
  "exclude": ["node_modules"]
}